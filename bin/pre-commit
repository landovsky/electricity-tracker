#!/usr/bin/env bash
set -e

# Only lint staged Ruby files
STAGED_RB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rb$' || true)

if [ -n "$STAGED_RB_FILES" ]; then
  echo "==> Running RuboCop (auto-fix) on staged files..."
  bin/rubocop --force-exclusion -A $STAGED_RB_FILES
  # Re-stage any auto-fixed files
  git add $STAGED_RB_FILES
fi

echo "==> Running tests..."
bundle exec rspec --fail-fast

echo "All checks passed."
