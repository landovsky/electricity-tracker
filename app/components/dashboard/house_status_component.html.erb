<turbo-frame id="house-status" class="block">
  <%# TODO: temporary sign-out button in header_action until proper user navigation is implemented %>
  <%= render Shared::CardComponent.new(
    title: t("dashboard.house_status.title", property_name: property_name),
    header_action: button_to(t("layout.log_out"), logout_path, method: :delete, class: "cursor-pointer text-xs text-gray-400 hover:text-gray-600", form: { data: { turbo_frame: "_top" } })
  ) do %>
    <!-- Who's here -->
    <div>
      <h3 class="text-xs font-medium text-gray-400 uppercase mb-2"><%= t("dashboard.house_status.currently_here") %></h3>
      <% if current_visitors.any? %>
        <div class="space-y-2">
          <% current_visitors.each do |visitor| %>
            <% stay = visitor.stays.find { |s| s.open? } %>
            <%= render Dashboard::VisitorCardComponent.new(
              visitor: visitor,
              checked_in_at: stay&.check_in_event&.recorded_at,
              stay_id: stay&.id
            ) %>
          <% end %>
        </div>
      <% else %>
        <%= render Shared::EmptyStateComponent.new(message: t("dashboard.house_status.nobody_here")) %>
      <% end %>
    </div>

    <!-- Current readings -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-xs font-medium text-gray-400 uppercase"><%= t("dashboard.house_status.latest_readings") %></h3>
        <%= link_to consumption_reports_path, class: "cursor-pointer text-xs text-brand-600 font-medium hover:text-brand-700 flex items-center gap-1", data: { turbo_frame: "_top" } do %>
          <%= t("layout.nav.reports") %>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        <% end %>
      </div>
      <% if last_meter_readings.any? %>
        <div class="grid grid-cols-2 gap-3">
          <% if main_reading %>
            <%= render Dashboard::MeterReadingCardComponent.new(
              label: main_reading[:label],
              value: main_reading[:value],
              date: main_reading[:date],
              icon_class: "fa-gauge-high"
            ) %>
          <% end %>
          <% if secondary_reading %>
            <%= render Dashboard::MeterReadingCardComponent.new(
              label: secondary_reading[:label],
              value: secondary_reading[:value],
              date: secondary_reading[:date],
              icon_class: "fa-gauge"
            ) %>
          <% end %>
        </div>
      <% else %>
        <%= render Shared::EmptyStateComponent.new(message: t("dashboard.house_status.no_readings")) %>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
