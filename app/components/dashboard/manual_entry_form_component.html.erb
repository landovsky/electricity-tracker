<%= form_with url: manual_consumption_entries_path, method: :post, class: "space-y-4", data: { turbo_frame: "_top" } do |f| %>
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.manual_entry_form.visitor") %></label>
    <%= select_tag :visitor_id,
      options_from_collection_for_select(visitors, :id, :name, selected_visitor_id),
      prompt: t("dashboard.manual_entry_form.select_visitor"),
      class: "w-full border-2 border-brand-300 bg-brand-50/30 rounded-lg px-3 py-3 text-base font-medium focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
      **select_validation
    %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.manual_entry_form.date") %></label>
    <%= date_field_tag :date,
      Date.current,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= t("dashboard.manual_entry_form.consumption") %> <span class="text-red-500">*</span>
    </label>
    <div class="relative">
      <%= number_field_tag :kwh,
        nil,
        placeholder: "0",
        class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 pr-12 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
        **number_validation
      %>
      <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-gray-400">kWh</span>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= t("dashboard.manual_entry_form.note") %> <span class="text-red-500">*</span>
    </label>
    <%= text_field_tag :note,
      nil,
      placeholder: t("dashboard.manual_entry_form.note_placeholder"),
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
      **field_validation
    %>
  </div>

  <%= button_tag type: "submit", class: "w-full bg-violet-600 text-white py-3 rounded-lg font-medium text-sm hover:bg-violet-700 active:bg-violet-800 transition-colors" do %>
    <%= render Shared::IconComponent.new(icon_class: "fa-bolt", color: "mr-1.5") %>
    <%= t("dashboard.manual_entry_form.submit") %>
  <% end %>
<% end %>
