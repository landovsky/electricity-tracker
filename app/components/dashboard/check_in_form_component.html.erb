<%= form_with url: stays_path, method: :post, class: "space-y-4" do |f| %>
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.visitor") %></label>
    <%= select_tag :visitor_id,
      options_from_collection_for_select(visitors, :id, :name),
      prompt: t("dashboard.check_in_form.select_visitor"),
      class: "w-full border-2 border-brand-300 bg-brand-50/30 rounded-lg px-3 py-3 text-base font-medium focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.date_time") %></label>
    <%= datetime_field_tag :recorded_at,
      Time.current.strftime("%Y-%m-%dT%H:%M"),
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <% if main_meter %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <%= t("dashboard.check_in_form.main_meter") %> <span class="text-red-500">*</span>
      </label>
      <%= number_field_tag :main_meter_reading,
        last_main_reading&.dig(:value),
        placeholder: "kWh",
        class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
      %>
      <% if last_main_reading %>
        <p class="text-xs text-gray-400 mt-1"><%= last_reading_hint(last_main_reading) %></p>
      <% end %>
    </div>
  <% end %>

  <% if secondary_meter %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <%= secondary_meter.label %> <span class="text-gray-400"><%= t("dashboard.check_in_form.optional") %></span>
      </label>
      <%= number_field_tag :secondary_meter_reading,
        last_secondary_reading&.dig(:value),
        placeholder: "kWh",
        class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
      %>
      <% if last_secondary_reading %>
        <p class="text-xs text-gray-400 mt-1"><%= last_reading_hint(last_secondary_reading) %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.note") %> <span class="text-gray-400"><%= t("dashboard.check_in_form.optional") %></span></label>
    <%= text_field_tag :note,
      nil,
      placeholder: t("dashboard.check_in_form.note_placeholder"),
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <%= button_tag type: "submit", class: "w-full bg-brand-600 text-white py-3 rounded-lg font-medium text-sm hover:bg-brand-700 active:bg-brand-800 transition-colors" do %>
    <%= render Shared::IconComponent.new(icon_class: "fa-right-to-bracket", color: "mr-1.5") %>
    <%= t("dashboard.check_in_form.submit") %>
  <% end %>
<% end %>
