<%= form_with url: stays_path, method: :post, class: "space-y-4", data: { turbo_frame: "_top" } do |f| %>
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.visitor") %></label>
    <%= select_tag :visitor_id,
      options_from_collection_for_select(visitors, :id, :name, selected_visitor_id),
      prompt: t("dashboard.check_in_form.select_visitor"),
      class: "w-full border-2 border-brand-300 bg-brand-50/30 rounded-lg px-3 py-3 text-base font-medium focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
      **select_validation
    %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.date_time") %></label>
    <%= datetime_field_tag :recorded_at,
      Time.current.strftime("%Y-%m-%dT%H:%M"),
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <div class="space-y-3">
    <% meter_rows.each do |row| %>
      <div class="<%= 'flex gap-3' if row.size > 1 %>">
        <% row.each do |meter| %>
          <% reading = last_reading_for(meter) %>
          <div class="<%= 'flex-1' if row.size > 1 %>">
            <label class="block text-sm font-medium text-gray-700 mb-1">
              <%= meter.label %>
              <% if meter_required?(meter) %>
                <span class="text-red-500">*</span>
              <% else %>
                <span class="text-gray-400"><%= t("dashboard.check_in_form.optional") %></span>
              <% end %>
            </label>
            <%= number_field_tag "meter_readings[#{meter.id}]",
              reading&.dig(:value),
              placeholder: "kWh",
              step: "any",
              class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
              **(meter_required?(meter) ? number_validation : {})
            %>
            <% if reading %>
              <p class="text-xs text-gray-400 mt-1"><%= last_reading_hint(reading) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_in_form.note") %> <span class="text-gray-400"><%= t("dashboard.check_in_form.optional") %></span></label>
    <%= text_field_tag :note,
      nil,
      placeholder: t("dashboard.check_in_form.note_placeholder"),
      class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
    %>
  </div>

  <%= button_tag type: "submit", class: "w-full bg-emerald-600 text-white py-3 rounded-lg font-medium text-sm hover:bg-emerald-700 active:bg-emerald-800 transition-colors" do %>
    <%= render Shared::IconComponent.new(icon_class: "fa-right-to-bracket", color: "mr-1.5") %>
    <%= t("dashboard.check_in_form.submit") %>
  <% end %>
<% end %>
