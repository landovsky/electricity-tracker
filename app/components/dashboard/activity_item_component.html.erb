<li class="px-4 py-3">
  <div class="flex items-start justify-between">
    <div>
      <%= render Shared::IconComponent.new(icon_class: icon_class, color: "#{icon_color} text-xs mr-1.5") %>
      <span class="text-sm font-medium text-gray-900"><%= visitor_name %></span>
      <span class="text-sm text-gray-500"> <%= action %></span>
    </div>
    <span class="text-xs text-gray-400"><%= formatted_date %></span>
  </div>
  <% if details.present? %>
    <div class="ml-5 text-xs text-gray-400 mt-0.5"><%= details %></div>
  <% end %>
</li>
