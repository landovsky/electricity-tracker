<turbo-frame id="recent-activity">
  <%= render Shared::CardComponent.new(
    title: t("dashboard.recent_activity.title"),
    header_action: ('<a href="' + helpers.readings_history_path + '" data-turbo-frame="_top" class="text-xs text-brand-600 font-medium hover:text-brand-700">' + t("dashboard.recent_activity.view_all") + ' <i class="fa-solid fa-arrow-right ml-0.5"></i></a>').html_safe
  ) do %>
    <% if combined_activity.any? %>
      <ul class="divide-y divide-gray-50 -mx-4 -my-4">
        <% combined_activity.each do |item| %>
          <%= render Dashboard::ActivityItemComponent.new(
            type: item[:type],
            visitor_name: item[:visitor_name],
            action: item[:action],
            date: item[:date],
            details: item[:details]
          ) %>
        <% end %>
      </ul>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(message: t("dashboard.recent_activity.no_activity")) %>
    <% end %>
  <% end %>
</turbo-frame>
