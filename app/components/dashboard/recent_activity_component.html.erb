<turbo-frame id="recent-activity">
  <%= render Shared::CardComponent.new(
    title: "Recent Activity",
    header_action: '<a href="/history" class="text-xs text-brand-600 font-medium hover:text-brand-700">View all <i class="fa-solid fa-arrow-right ml-0.5"></i></a>'.html_safe
  ) do %>
    <% if combined_activity.any? %>
      <ul class="divide-y divide-gray-50 -mx-4 -my-4">
        <% combined_activity.each do |item| %>
          <%= render Dashboard::ActivityItemComponent.new(
            type: item[:type],
            visitor_name: item[:visitor_name],
            action: item[:action],
            date: item[:date],
            details: item[:details]
          ) %>
        <% end %>
      </ul>
    <% else %>
      <%= render Shared::EmptyStateComponent.new(message: "No recent activity.") %>
    <% end %>
  <% end %>
</turbo-frame>
