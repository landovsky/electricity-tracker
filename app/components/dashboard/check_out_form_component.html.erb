<% if current_visitors.any? %>
  <%= form_with url: check_out_stay_path(current_visitors.first.stays.find { |s| s.open? }&.id || 0), method: :patch, class: "space-y-4", data: { controller: "checkout-form", checkout_form_target: "form", checkout_form_path_template_value: check_out_stay_path("__STAY_ID__"), turbo_frame: "_top" } do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_out_form.visitor") %></label>
      <%= select_tag :stay_id,
        options_for_select(visitor_options_with_data, selected_stay_id),
        class: "w-full border-2 border-brand-300 bg-brand-50/30 rounded-lg px-3 py-3 text-base font-medium focus:ring-2 focus:ring-brand-500 focus:border-brand-500",
        data: { checkout_form_target: "visitorSelect", action: "change->checkout-form#updateAction" }
      %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_out_form.date_time") %></label>
      <%= datetime_field_tag :recorded_at,
        Time.current.strftime("%Y-%m-%dT%H:%M"),
        class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
      %>
    </div>

    <div class="space-y-3">
      <% meter_rows.each do |row| %>
        <div class="<%= 'flex gap-3' if row.size > 1 %>">
          <% row.each do |meter| %>
            <% reading = last_reading_for(meter) %>
            <% prefilled = prefilled_value_for(meter) %>
            <div class="<%= 'flex-1' if row.size > 1 %>">
              <label class="block text-sm font-medium text-gray-700 mb-1">
                <%= meter.label %>
                <% if meter_required?(meter) %>
                  <span class="text-red-500">*</span>
                <% else %>
                  <span class="text-gray-400"><%= t("dashboard.check_out_form.optional") %></span>
                <% end %>
              </label>
              <div class="relative">
                <%= number_field_tag "meter_readings[#{meter.id}]",
                  prefilled || reading&.dig(:value),
                  placeholder: "kWh",
                  step: "any",
                  class: "w-full rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 #{prefilled ? 'border-2 border-emerald-400 bg-emerald-50/50 pr-9' : 'border border-gray-300'}",
                  **(meter_required?(meter) ? number_validation : {})
                %>
                <% if prefilled %>
                  <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-emerald-500">
                    <i class="fa-solid fa-circle-check"></i>
                  </span>
                <% end %>
              </div>
              <% if prefilled %>
                <p class="text-xs text-emerald-600 mt-0.5"><%= t("dashboard.check_out_form.from_camera") %></p>
              <% elsif reading %>
                <p class="text-xs text-gray-400 mt-1"><%= last_reading_hint(reading) %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("dashboard.check_out_form.note") %> <span class="text-gray-400"><%= t("dashboard.check_out_form.optional") %></span></label>
      <%= text_field_tag :note,
        nil,
        placeholder: t("dashboard.check_out_form.note_placeholder"),
        class: "w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
      %>
    </div>

    <% if camera_detections.any? %>
      <div class="flex gap-2 overflow-x-auto pb-1">
        <% camera_detections.each do |detection| %>
          <% if detection.photo.attached? %>
            <a href="<%= rails_blob_path(detection.photo, only_path: true) %>" target="_blank" class="flex-shrink-0">
              <div class="w-16 h-16 rounded-lg overflow-hidden border-2 border-emerald-300 relative">
                <%= image_tag detection.photo.variant(resize_to_fill: [128, 128]), class: "w-full h-full object-cover", loading: "lazy" %>
                <span class="absolute bottom-0 right-0 bg-emerald-500 text-white text-[9px] px-1 rounded-tl"><%= detection.meter&.label&.truncate(8) %></span>
              </div>
            </a>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-2">
      <%= link_to camera_session_path(SecureRandom.uuid, event_type: "check_out", visitor_name: current_visitors.first&.name || ""),
            class: "px-4 py-3 rounded-lg font-medium text-sm text-center text-white bg-gradient-to-r from-blue-500 via-indigo-500 to-violet-500 hover:from-blue-600 hover:via-indigo-600 hover:to-violet-600 active:from-blue-700 active:via-indigo-700 active:to-violet-700 shadow-sm hover:shadow-md transition-all flex items-center justify-center gap-1.5",
            data: { turbo_frame: "_top" } do %>
        <i class="fa-solid fa-camera"></i>
        AI
      <% end %>
      <%= button_tag type: "submit", class: "flex-1 py-3 rounded-lg font-medium text-sm border-2 border-amber-600 text-amber-700 bg-white hover:bg-amber-50 active:bg-amber-100 transition-colors" do %>
        <%= render Shared::IconComponent.new(icon_class: "fa-right-from-bracket", color: "mr-1.5") %>
        <%= t("dashboard.check_out_form.submit") %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= render Shared::EmptyStateComponent.new(message: t("dashboard.check_out_form.no_visitors")) %>
<% end %>
