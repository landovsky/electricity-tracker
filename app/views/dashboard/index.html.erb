<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <% if @property.nil? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <p class="text-yellow-800"><%= t("dashboard.no_property") %></p>
    </div>
    <div class="mt-4 text-center">
      <%= link_to t("layout.log_out"), logout_path, data: { turbo_method: :delete }, class: "text-sm text-gray-500 hover:text-gray-700 underline" %>
    </div>
  <% else %>
    <%= render Dashboard::HouseStatusComponent.new(
      current_visitors: @current_visitors,
      last_meter_readings: @last_meter_readings,
      property_name: @property.name
    ) %>

    <%= render Dashboard::ActionFormsComponent.new(
      visitors_for_checkin: @visitors_for_checkin,
      visitors_for_checkout: @visitors_for_checkout,
      meters: @meters,
      last_readings: @last_meter_readings,
      default_visitor_id: @default_visitor_id,
      prefilled_readings: @prefilled_readings,
      default_tab: @default_tab
    ) %>

    <%= render Dashboard::RecentActivityComponent.new(
      recent_events: @recent_events,
      recent_manual_entries: @recent_manual_entries
    ) %>
  <% end %>
</div>
