<div class="max-w-4xl mx-auto px-4 py-5 space-y-5">
  <h1 class="text-lg font-bold text-gray-900"><%= t("admin.photo_detections.title") %></h1>

  <% if @detections.any? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.datetime") %></th>
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.status") %></th>
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.meter") %></th>
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.value") %></th>
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.photo") %></th>
            <th class="px-4 py-2.5"><%= t("admin.photo_detections.error") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @detections.each do |detection| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 text-gray-700 whitespace-nowrap"><%= I18n.l(detection.created_at, format: :short) %></td>
              <td class="px-4 py-2">
                <% case detection.status %>
                <% when "detected" %>
                  <span class="inline-block text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">detected</span>
                <% when "low_confidence" %>
                  <span class="inline-block text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">low confidence</span>
                <% when "not_meter" %>
                  <span class="inline-block text-xs font-medium text-red-700 bg-red-50 px-2 py-0.5 rounded-full">not meter</span>
                <% when "error" %>
                  <span class="inline-block text-xs font-medium text-red-700 bg-red-50 px-2 py-0.5 rounded-full">error</span>
                <% when "replaced" %>
                  <span class="inline-block text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">replaced</span>
                <% when "processing" %>
                  <span class="inline-block text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full">processing</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-gray-700"><%= detection.meter&.label || "—" %></td>
              <td class="px-4 py-2 text-gray-900 font-mono"><%= detection.detected_value ? number_with_delimiter(detection.detected_value, delimiter: " ") : "—" %></td>
              <td class="px-4 py-2">
                <% if detection.photo.attached? %>
                  <a href="<%= rails_blob_path(detection.photo.variant(:medium), only_path: true) %>" target="_blank" class="text-blue-600 hover:text-blue-800">
                    <i class="fa-solid fa-image"></i>
                  </a>
                <% else %>
                  <span class="text-gray-300"><i class="fa-solid fa-image-slash"></i> —</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-xs text-red-500 max-w-48 truncate" title="<%= detection.error_message %>"><%= detection.error_message || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 text-gray-400">
      <i class="fa-solid fa-camera text-3xl mb-2"></i>
      <p class="text-sm"><%= t("admin.photo_detections.empty") %></p>
    </div>
  <% end %>
</div>
