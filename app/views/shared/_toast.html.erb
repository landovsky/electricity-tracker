<%
  # Toast notification component
  # Supports flash types: notice (green), alert (red), warning (yellow)
  flash_type = local_assigns[:flash_type] || "notice"
  message = local_assigns[:message]

  # Map flash types to Tailwind classes
  classes = case flash_type.to_s
  when "notice"
    "bg-green-50 border-green-200 text-green-800"
  when "alert", "error"
    "bg-red-50 border-red-200 text-red-800"
  when "warning"
    "bg-yellow-50 border-yellow-200 text-yellow-800"
  else
    "bg-blue-50 border-blue-200 text-blue-800"
  end

  # Map flash types to icon colors
  icon_color = case flash_type.to_s
  when "notice"
    "text-green-600"
  when "alert", "error"
    "text-red-600"
  when "warning"
    "text-yellow-600"
  else
    "text-blue-600"
  end

  # Map flash types to icon paths
  icon_path = case flash_type.to_s
  when "notice"
    "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
  when "alert", "error"
    "M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
  when "warning"
    "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
  else
    "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
  end
%>

<div
  data-controller="toast"
  data-toast-duration-value="3000"
  class="<%= classes %> border rounded-lg shadow-lg px-4 py-3 flex items-center gap-3 min-w-80 max-w-md opacity-0 transition-opacity duration-300"
  role="alert"
>
  <svg class="<%= icon_color %> w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>"></path>
  </svg>
  <p class="text-sm font-medium flex-1"><%= message %></p>
</div>
