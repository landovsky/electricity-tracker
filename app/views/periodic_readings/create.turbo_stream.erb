<%# Turbo Stream response for periodic meter reading %>

<%# Update house status with new readings %>
<%= turbo_stream.replace "house-status" do %>
  <%= render Dashboard::HouseStatusComponent.new(
    current_visitors: [],
    last_meter_readings: @last_meter_readings,
    property_name: @property_name,
    tracking_mode: "meter_only"
  ) %>
<% end %>

<%# Update recent activity %>
<%= turbo_stream.replace "recent-activity" do %>
  <%= render Dashboard::RecentActivityComponent.new(
    recent_events: @recent_events,
    recent_manual_entries: []
  ) %>
<% end %>

<%# Reset periodic reading form %>
<%= turbo_stream.replace "periodic-reading-form" do %>
  <turbo-frame id="periodic-reading-form" class="block">
    <%= render Dashboard::PeriodicReadingFormComponent.new(
      meters: @meters,
      last_readings: @last_meter_readings
    ) %>
  </turbo-frame>
<% end %>

<%# Show toast notification %>
<%= turbo_stream.append "toast-container" do %>
  <% flash.each do |flash_type, message| %>
    <%= render "shared/toast", flash_type: flash_type, message: message %>
  <% end %>
<% end %>
