<h1><%= t("visitors.edit.title") %></h1>

<%= form_with model: @visitor do |form| %>
  <% if @visitor.errors.any? %>
    <div>
      <h2><%= t("errors.messages.not_saved", count: @visitor.errors.count, resource: Visitor.model_name.human) %></h2>
      <ul>
        <% @visitor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select :status, Visitor.statuses.keys, {}, {} %>
  </div>

  <div>
    <%= form.label :note %>
    <%= form.text_area :note %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<%= link_to t("visitors.edit.show"), visitor_path(@visitor) %>
<%= link_to t("visitors.edit.back"), visitors_path %>
