<h1><%= t("visitors.index.title") %></h1>

<% if @visitors.any? %>
  <ul>
    <% @visitors.each do |visitor| %>
      <li><%= visitor.name %> - <%= visitor.status %></li>
    <% end %>
  </ul>
<% else %>
  <p><%= t("visitors.index.no_visitors") %></p>
<% end %>

<%= link_to t("visitors.index.new_visitor"), new_visitor_path %>
