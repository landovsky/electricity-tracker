<%= form_with model: visitor, class: "space-y-4" do |form| %>
  <% if visitor.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3">
      <h2 class="text-sm font-medium text-red-800 mb-1">
        <%= t("errors.messages.not_saved", count: visitor.errors.count, resource: Visitor.model_name.human) %>
      </h2>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
        <% visitor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :status, Visitor.statuses.keys.map { |s| [I18n.t("activerecord.enums.visitor.status.#{s}", default: s.humanize), s] }, {}, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :note, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :note, rows: 3, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors resize-none" %>
  </div>

  <div>
    <%= form.submit class: "w-full bg-brand-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-brand-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
