<%= form_with model: user, class: "space-y-4" do |form| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3">
      <h2 class="text-sm font-medium text-red-800 mb-1">
        <%= t("errors.messages.not_saved", count: user.errors.count, resource: User.model_name.human) %>
      </h2>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-0.5">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.email_field :email, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :phone_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.telephone_field :phone_number, placeholder: "+420 777 123 456", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :role, User.roles.keys.map { |r| [t("users.form.role_#{r}"), r] }, {}, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.label :default_visitor_id, t("users.form.default_visitor"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :default_visitor_id, @visitors.map { |v| [v.name, v.id] }, { include_blank: "—" }, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <div>
    <%= form.submit class: "w-full bg-brand-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-brand-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
