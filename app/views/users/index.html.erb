<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-bold text-gray-900"><%= t("users.index.title") %></h1>
    <%= link_to new_user_path, class: "inline-flex items-center gap-1.5 bg-brand-600 text-white text-sm font-medium px-3 py-1.5 rounded-lg hover:bg-brand-700 transition-colors" do %>
      <i class="fa-solid fa-plus text-xs"></i>
      <%= t("users.index.new_user") %>
    <% end %>
  </div>

  <% if @users.any? %>
    <div class="space-y-2">
      <% @users.each do |user| %>
        <%= link_to user_path(user), class: "block bg-white rounded-xl shadow-sm border border-gray-100 px-4 py-3 hover:border-brand-200 hover:shadow transition-all" do %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-brand-50 flex items-center justify-center">
                <i class="fa-solid fa-user text-brand-600 text-sm"></i>
              </div>
              <div>
                <span class="font-medium text-gray-900"><%= user.name.presence || user.email %></span>
                <% if user.name.present? && user.email.present? %>
                  <p class="text-xs text-gray-400"><%= user.email %></p>
                <% end %>
              </div>
            </div>
            <% if user.admin? %>
              <span class="text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full"><%= t("users.index.role_admin") %></span>
            <% else %>
              <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"><%= t("users.index.role_member") %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 px-4 py-8 text-center">
      <div class="text-gray-300 mb-2"><i class="fa-solid fa-users text-3xl"></i></div>
      <p class="text-sm text-gray-400 italic"><%= t("users.index.no_users") %></p>
    </div>
  <% end %>
</div>
