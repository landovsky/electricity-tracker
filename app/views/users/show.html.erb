<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <%# Header with back link %>
  <div class="flex items-center gap-3">
    <%= link_to users_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <h1 class="text-lg font-bold text-gray-900"><%= @user.name.presence || @user.email %></h1>
    <% if @user.admin? %>
      <span class="text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full"><%= t("users.show.role_admin") %></span>
    <% else %>
      <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full"><%= t("users.show.role_member") %></span>
    <% end %>
  </div>

  <%# User info card %>
  <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide"><%= t("users.show.details") %></h2>
      <%= link_to edit_user_path(@user), class: "text-sm text-brand-600 font-medium hover:text-brand-700" do %>
        <i class="fa-solid fa-pen-to-square mr-1"></i><%= t("users.show.edit") %>
      <% end %>
    </div>
    <div class="px-4 py-4 space-y-3">
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-envelope text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= @user.email.presence || "—" %></span>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-phone text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= @user.phone_number.presence || "—" %></span>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-user-tag text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= t("users.show.default_visitor") %>: <%= @user.default_visitor&.name || "—" %></span>
      </div>
    </div>
  </section>

  <%# Archive button %>
  <% if @user != current_user %>
    <div class="flex justify-end">
      <%= button_to t("users.show.archive"), archive_user_path(@user), method: :patch, class: "text-sm text-red-600 font-medium hover:text-red-700 cursor-pointer", data: { turbo_confirm: t("users.show.archive_confirm") } %>
    </div>
  <% end %>
</div>
