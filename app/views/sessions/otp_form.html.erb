<% content_for(:title, t("sessions.otp.title")) %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-brand-50 flex items-center justify-center">
          <i class="fa-solid fa-comment-sms text-brand-600 text-2xl"></i>
        </div>
        <h1 class="text-xl font-bold text-gray-900"><%= t("sessions.otp.heading") %></h1>
        <p class="text-sm text-gray-500 mt-1"><%= t("sessions.otp.instruction") %></p>
      </div>

      <% if flash[:alert] %>
        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-800 text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: verify_otp_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="code" class="block text-sm font-medium text-gray-700 mb-1"><%= t("sessions.otp.code_label") %></label>
          <input
            type="text"
            name="code"
            id="code"
            required
            autofocus
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            placeholder="000000"
            class="w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm text-center text-2xl font-mono tracking-[0.5em] focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
          >
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-brand-600 text-white font-medium rounded-lg hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors"
        >
          <%= t("sessions.otp.submit") %>
        </button>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to t("sessions.otp.back"), login_path, class: "text-sm text-brand-600 font-medium hover:text-brand-700" %>
      </div>
    </div>
  </div>
</div>
