<% content_for(:title, t("sessions.confirm.title")) %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-brand-50 flex items-center justify-center">
        <i class="fa-solid fa-right-to-bracket text-brand-600 text-2xl"></i>
      </div>

      <h1 class="text-xl font-bold text-gray-900 mb-2"><%= t("sessions.confirm.heading") %></h1>
      <p class="text-sm text-gray-500 mb-6"><%= t("sessions.confirm.instruction") %></p>

      <%= button_to t("sessions.confirm.submit"), auth_verify_path(token: @token), method: :post,
            form: { data: { turbo: false } },
            class: "w-full py-2.5 px-4 bg-brand-600 text-white font-medium rounded-lg hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors" %>

      <div class="mt-4">
        <%= link_to t("sessions.confirm.back"), login_path, class: "text-sm text-brand-600 font-medium hover:text-brand-700" %>
      </div>
    </div>
  </div>
</div>
