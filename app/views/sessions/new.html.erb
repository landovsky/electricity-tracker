<% content_for(:title, t("sessions.new.title")) %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-lg p-8" data-controller="login-method">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900"><%= t("sessions.new.heading") %></h1>
        <p class="text-sm text-gray-500 mt-1"><%= t("sessions.new.subtitle") %></p>
      </div>

      <% if flash[:notice] %>
        <div class="mb-4 p-3 rounded-lg bg-green-50 text-green-800 text-sm">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-800 text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%# Method selector buttons %>
      <div class="grid grid-cols-2 gap-3 mb-6">
        <button
          type="button"
          data-login-method-target="emailButton"
          data-action="login-method#selectEmail"
          class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-brand-600 bg-brand-50 text-brand-700 transition-all"
        >
          <i class="fa-solid fa-envelope text-xl"></i>
          <span class="text-sm font-medium"><%= t("sessions.new.method_email") %></span>
        </button>

        <button
          type="button"
          data-login-method-target="smsButton"
          data-action="login-method#selectSms"
          class="flex flex-col items-center gap-2 p-4 rounded-xl border-2 border-gray-200 text-gray-500 hover:border-gray-300 transition-all"
        >
          <i class="fa-solid fa-comment-sms text-xl"></i>
          <span class="text-sm font-medium"><%= t("sessions.new.method_sms") %></span>
        </button>
      </div>

      <%# Email form %>
      <div data-login-method-target="emailPanel">
        <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1"><%= t("sessions.new.email_label") %></label>
            <input
              type="email"
              name="email"
              id="email"
              required
              autofocus
              placeholder="<%= t("sessions.new.email_placeholder") %>"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
            >
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-brand-600 text-white font-medium rounded-lg hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors"
          >
            <%= t("sessions.new.submit_email") %>
          </button>
        <% end %>

        <p class="mt-3 text-xs text-gray-400 text-center">
          <%= t("sessions.new.help_text_email") %>
        </p>
      </div>

      <%# SMS form %>
      <div data-login-method-target="smsPanel" class="hidden">
        <%= form_with url: login_sms_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <label for="phone_number" class="block text-sm font-medium text-gray-700 mb-1"><%= t("sessions.new.phone_label") %></label>
            <input
              type="tel"
              name="phone_number"
              id="phone_number"
              required
              placeholder="<%= t("sessions.new.phone_placeholder") %>"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"
            >
          </div>

          <button
            type="submit"
            class="w-full py-2.5 px-4 bg-brand-600 text-white font-medium rounded-lg hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-colors"
          >
            <%= t("sessions.new.submit_sms") %>
          </button>
        <% end %>

        <p class="mt-3 text-xs text-gray-400 text-center">
          <%= t("sessions.new.help_text_sms") %>
        </p>
      </div>
    </div>
  </div>
</div>
