<% content_for(:title, "Login — Electricity Tracker") %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Electricity Tracker</h1>
        <p class="text-sm text-gray-500 mt-1">Sign in with a magic link</p>
      </div>

      <% if flash[:notice] %>
        <div class="mb-4 p-3 rounded-lg bg-green-50 text-green-800 text-sm">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-800 text-sm">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            autofocus
            placeholder="you@example.com"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          >
        </div>

        <button
          type="submit"
          class="w-full py-2 px-4 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
        >
          Send login link
        </button>
      <% end %>

      <p class="mt-4 text-xs text-gray-400 text-center">
        We'll email you a magic link to sign in — no password needed.
      </p>
    </div>
  </div>
</div>
