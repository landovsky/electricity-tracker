<% content_for(:title, t("sessions.email_sent.title")) %>

<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div class="w-full max-w-sm">
    <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-brand-50 flex items-center justify-center">
        <i class="fa-solid fa-envelope text-brand-600 text-2xl"></i>
      </div>

      <h1 class="text-xl font-bold text-gray-900 mb-2"><%= t("sessions.email_sent.heading") %></h1>
      <p class="text-sm text-gray-500 mb-6"><%= t("sessions.email_sent.instruction") %></p>

      <div class="bg-gray-50 rounded-lg p-3 mb-6">
        <p class="text-xs text-gray-400"><%= t("sessions.email_sent.expiry") %></p>
      </div>

      <%= link_to t("sessions.email_sent.back"), login_path, class: "text-sm text-brand-600 font-medium hover:text-brand-700" %>
    </div>
  </div>
</div>
