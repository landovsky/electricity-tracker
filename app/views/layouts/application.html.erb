<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workspace">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# FontAwesome icons (kit from prototype) %>
    <script src="https://kit.fontawesome.com/219bb33c4b.js" crossorigin="anonymous"></script>

    <%# Tailwind CSS (built from app/assets/tailwind/application.css) %>
    <% if Rails.env.development? %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "" %>
    <% else %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? %>
      <nav class="bg-white border-b border-gray-200 px-4 py-2 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <%= link_to t("layout.nav.dashboard"), root_path, class: "text-sm font-medium #{request.path == '/' ? 'text-brand-600' : 'text-gray-500 hover:text-gray-700'}" %>
          <%= link_to t("layout.nav.reports"), consumption_reports_path, class: "text-sm font-medium #{request.path.start_with?('/consumption_reports') ? 'text-brand-600' : 'text-gray-500 hover:text-gray-700'}" %>
          <%= link_to t("layout.nav.history"), readings_history_path, class: "text-sm font-medium #{request.path.start_with?('/readings_history') ? 'text-brand-600' : 'text-gray-500 hover:text-gray-700'}" %>
          <%= link_to t("layout.nav.visitors"), visitors_path, class: "text-sm font-medium #{request.path.start_with?('/visitors') ? 'text-brand-600' : 'text-gray-500 hover:text-gray-700'}" %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-400"><%= current_user.name %></span>
          <%= button_to t("layout.log_out"), logout_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-700" %>
        </div>
      </nav>
    <% end %>
    <div id="toast-container" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 space-y-2"></div>
    <%= yield %>
  </body>
</html>
