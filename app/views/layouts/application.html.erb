<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Workspace">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# FontAwesome icons (kit from prototype) %>
    <script src="https://kit.fontawesome.com/219bb33c4b.js" crossorigin="anonymous"></script>

    <%# Tailwind CSS (built from app/assets/tailwind/application.css) %>
    <% if Rails.env.development? %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "" %>
    <% else %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if logged_in? && current_user.admin? %>
      <nav class="px-4 py-2 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to root_path, class: "cursor-pointer text-blue-600 hover:text-blue-700 leading-none" do %><i class="fa-solid fa-house text-sm"></i><% end %>
          <%= link_to t("layout.admin_nav.properties"), properties_path, class: "cursor-pointer text-sm font-medium leading-none #{request.path.start_with?('/properties') ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'}" %>
          <%= link_to t("layout.admin_nav.visitors"), visitors_path, class: "cursor-pointer text-sm font-medium leading-none #{request.path.start_with?('/visitors') ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'}" %>
          <%= link_to t("layout.admin_nav.users"), users_path, class: "cursor-pointer text-sm font-medium leading-none #{request.path.start_with?('/users') ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'}" %>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-400 leading-none"><%= current_user.name %></span>
          <%= link_to t("layout.log_out"), logout_path, data: { turbo_method: :delete }, class: "cursor-pointer text-sm text-gray-400 hover:text-gray-600 leading-none" %>
        </div>
      </nav>
    <% end %>
    <div id="toast-container" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 space-y-2">
      <% flash.each do |flash_type, message| %>
        <%= render "shared/toast", flash_type: flash_type, message: message %>
      <% end %>
    </div>
    <%= yield %>
  </body>
</html>
