<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-bold text-gray-900"><%= t("properties.index.title") %></h1>
    <%= link_to new_property_path, class: "inline-flex items-center gap-1.5 bg-brand-600 text-white text-sm font-medium px-3 py-1.5 rounded-lg hover:bg-brand-700 transition-colors" do %>
      <i class="fa-solid fa-plus text-xs"></i>
      <%= t("properties.index.new_property") %>
    <% end %>
  </div>

  <% if @properties.any? %>
    <div class="space-y-2">
      <% @properties.each do |property| %>
        <%= link_to property_path(property), class: "block bg-white rounded-xl shadow-sm border border-gray-100 px-4 py-3 hover:border-brand-200 hover:shadow transition-all" do %>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-brand-50 flex items-center justify-center">
                <i class="fa-solid fa-building text-brand-600 text-sm"></i>
              </div>
              <div>
                <span class="font-medium text-gray-900"><%= property.name %></span>
                <% if property.address.present? %>
                  <p class="text-xs text-gray-400"><%= property.address %></p>
                <% end %>
              </div>
            </div>
            <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
              <%= property.meters.count %> <%= t("properties.index.meters") %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 px-4 py-8 text-center">
      <div class="text-gray-300 mb-2"><i class="fa-solid fa-building text-3xl"></i></div>
      <p class="text-sm text-gray-400 italic"><%= t("properties.index.no_properties") %></p>
    </div>
  <% end %>
</div>
