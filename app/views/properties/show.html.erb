<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <%# Header with back link %>
  <div class="flex items-center gap-3">
    <%= link_to properties_path, class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <h1 class="text-lg font-bold text-gray-900"><%= @property.name %></h1>
  </div>

  <%# Property info card %>
  <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide"><%= t("properties.show.details") %></h2>
      <%= link_to edit_property_path(@property), class: "text-sm text-brand-600 font-medium hover:text-brand-700" do %>
        <i class="fa-solid fa-pen-to-square mr-1"></i><%= t("properties.show.edit") %>
      <% end %>
    </div>
    <div class="px-4 py-4 space-y-3">
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-location-dot text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= @property.address.presence || "—" %></span>
      </div>
      <% if @property.subdomain.present? %>
        <div class="flex items-center gap-2 text-sm">
          <i class="fa-solid fa-globe text-gray-400 w-4 text-center"></i>
          <span class="text-gray-700"><%= @property.subdomain %>.kopernici.cz</span>
        </div>
      <% end %>
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-sliders text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= I18n.t("activerecord.enums.property.tracking_mode.#{@property.tracking_mode}") %></span>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-gauge text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= t("properties.show.meters_count") %>: <%= @property.meters.count %></span>
      </div>
      <div class="flex items-center gap-2 text-sm">
        <i class="fa-solid fa-people-group text-gray-400 w-4 text-center"></i>
        <span class="text-gray-700"><%= t("properties.show.current_visitors") %>: <%= @property.current_visitors.count %></span>
      </div>
    </div>
  </section>

  <%# Meters section %>
  <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide"><%= t("meters.section.title") %></h2>
      <%= link_to new_property_meter_path(@property), class: "text-sm text-brand-600 font-medium hover:text-brand-700" do %>
        <i class="fa-solid fa-plus mr-1"></i><%= t("meters.section.add") %>
      <% end %>
    </div>
    <div class="px-4 py-4">
      <% meters = @property.meters.kept.order(:label) %>
      <% if meters.any? %>
        <div class="space-y-2">
          <% meters.each do |meter| %>
            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-gauge text-gray-400 w-4 text-center"></i>
                <%= link_to meter.label, edit_property_meter_path(@property, meter), class: "text-gray-700 hover:text-brand-600 transition-colors" %>
                <% if meter.identifier.present? %>
                  <span class="text-xs font-mono text-gray-400 bg-gray-50 px-1.5 py-0.5 rounded"><%= meter.identifier %></span>
                <% end %>
                <% if meter.secondary? %>
                  <span class="text-xs font-medium text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded-full"><%= t("meters.section.secondary") %></span>
                <% end %>
                <% if meter.meter_group.present? %>
                  <span class="text-xs font-medium text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded-full"><%= meter.meter_group %></span>
                <% end %>
              </div>
              <span class="text-gray-400 text-xs">
                <% if meter.last_reading %>
                  <%= meter.last_reading.value_kwh %> <%= meter.unit %>
                <% else %>
                  <%= t("meters.section.no_readings") %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400 italic"><%= t("meters.section.no_meters") %></p>
      <% end %>
    </div>
  </section>

  <%# Allowed users — inline checkboxes, TODO: replace with scalable search/select when user count grows %>
  <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide"><%= t("properties.show.allowed_users") %></h2>
    </div>
    <div class="px-4 py-4">
      <%= form_with url: update_users_property_path(@property), method: :patch, class: "space-y-3" do |f| %>
        <% if @users.any? %>
          <div class="space-y-2 max-h-60 overflow-y-auto">
            <% @users.each do |user| %>
              <label class="flex items-center gap-2 cursor-pointer">
                <%= check_box_tag "property[user_ids][]", user.id, @property.user_ids.include?(user.id), class: "rounded border-gray-300 text-brand-600 focus:ring-brand-500", id: "property_user_ids_#{user.id}" %>
                <span class="text-sm text-gray-700"><%= user.name.presence || user.email || user.phone_number %></span>
                <% if user.admin? %>
                  <span class="text-xs font-medium text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded-full"><%= t("users.index.role_admin") %></span>
                <% end %>
              </label>
            <% end %>
          </div>
          <%# Hidden field to ensure empty selection sends an empty array %>
          <%= hidden_field_tag "property[user_ids][]", "" %>
          <div>
            <%= f.submit t("properties.show.save_users"), class: "bg-brand-600 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-brand-700 transition-colors cursor-pointer" %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 italic"><%= t("properties.show.no_users_available") %></p>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# Archive button %>
  <div class="flex justify-end">
    <%= button_to t("properties.show.archive"), archive_property_path(@property), method: :patch, class: "text-sm text-red-600 font-medium hover:text-red-700 cursor-pointer", data: { turbo_confirm: t("properties.show.archive_confirm") } %>
  </div>
</div>
