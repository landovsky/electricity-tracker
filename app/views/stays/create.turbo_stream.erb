<%# Turbo Stream response for check-in %>

<%# Update house status with new visitor %>
<%= turbo_stream.replace "house-status" do %>
  <%= render Dashboard::HouseStatusComponent.new(
    current_visitors: @current_visitors,
    last_meter_readings: @last_meter_readings,
    property_name: @property_name
  ) %>
<% end %>

<%# Update recent activity %>
<%= turbo_stream.replace "recent-activity" do %>
  <%= render Dashboard::RecentActivityComponent.new(
    recent_events: @recent_events,
    recent_manual_entries: @recent_manual_entries
  ) %>
<% end %>

<%# Forms are only refreshed on success. On failure they are left untouched so
    the visitor the user picked and the readings they typed survive the error. %>
<% if @succeeded %>
  <%# Refresh check-out list so the visitor just checked in can check out %>
  <%= turbo_stream.replace "check-out-form" do %>
    <turbo-frame id="check-out-form" data-action-forms-target="formPanel" data-form-type="checkout">
      <div class="p-4">
        <%= render Dashboard::CheckOutFormComponent.new(
          current_visitors: @visitors_for_checkout,
          last_readings: @last_meter_readings,
          meters: @meters,
          selected_visitor_id: @default_visitor_id
        ) %>
      </div>
    </turbo-frame>
  <% end %>

  <%# Reset check-in form (nil visitor so the prompt shows) %>
  <%= turbo_stream.replace "check-in-form" do %>
    <turbo-frame id="check-in-form" data-action-forms-target="formPanel" data-form-type="checkin">
      <div class="p-4">
        <%= render Dashboard::CheckInFormComponent.new(
          visitors: @visitors_for_checkin,
          last_readings: @last_meter_readings,
          meters: @meters,
          selected_visitor_id: nil
        ) %>
      </div>
    </turbo-frame>
  <% end %>
<% end %>

<%# Show toast notification %>
<%= turbo_stream.append "toast-container" do %>
  <% flash.each do |flash_type, message| %>
    <%= render "shared/toast", flash_type: flash_type, message: message %>
  <% end %>
<% end %>
