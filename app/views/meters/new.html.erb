<div class="max-w-lg mx-auto px-4 py-5 space-y-5">
  <div class="flex items-center gap-3">
    <%= link_to property_path(@property), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
      <i class="fa-solid fa-arrow-left"></i>
    <% end %>
    <h1 class="text-lg font-bold text-gray-900"><%= t("meters.new.title") %></h1>
  </div>

  <section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-4">
      <%= form_with model: @meter, url: property_meters_path(@property), class: "space-y-4" do |form| %>
        <% if @meter.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3">
            <p class="text-sm text-red-700 font-medium">
              <%= t("errors.messages.not_saved", count: @meter.errors.count, resource: Meter.model_name.human.downcase) %>
            </p>
            <ul class="mt-1 text-sm text-red-600 list-disc list-inside">
              <% @meter.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Label %>
        <div>
          <%= form.label :label, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :label, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: t("meters.new.label_placeholder"), **field_validation %>
        </div>

        <%# Meter type %>
        <div>
          <%= form.label :meter_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :meter_type, Meter.meter_types.keys.map { |k| [t("meters.new.meter_type_#{k}"), k] }, {}, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
        </div>

        <%# Unit %>
        <div>
          <%= form.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :unit, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", **field_validation %>
        </div>

        <%# Meter group (optional) %>
        <div>
          <%= form.label :meter_group, t("meters.new.meter_group"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :meter_group, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: t("meters.new.meter_group_placeholder"), **field_validation(required: false) %>
          <p class="mt-1 text-xs text-gray-400"><%= t("meters.new.meter_group_hint") %></p>
        </div>

        <%# Initial reading %>
        <div>
          <%= label_tag :initial_reading, t("meters.new.initial_reading"), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= number_field_tag :initial_reading, nil, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: "0", step: "any", min: "0", **number_validation %>
          <p class="mt-1 text-xs text-gray-400"><%= t("meters.new.initial_reading_hint") %></p>
        </div>

        <%# Submit %>
        <div>
          <%= form.submit t("meters.new.submit"), class: "w-full bg-brand-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-brand-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
