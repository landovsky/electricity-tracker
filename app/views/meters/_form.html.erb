<%= form_with model: meter, url: url, method: method, class: "space-y-4" do |form| %>
  <% if meter.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3">
      <p class="text-sm text-red-700 font-medium">
        <%= t("errors.messages.not_saved", count: meter.errors.count, resource: Meter.model_name.human.downcase) %>
      </p>
      <ul class="mt-1 text-sm text-red-600 list-disc list-inside">
        <% meter.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Label %>
  <div>
    <%= form.label :label, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :label, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: t("meters.form.label_placeholder"), **field_validation %>
  </div>

  <%# Identifier (physical meter number) %>
  <div>
    <%= form.label :identifier, t("meters.form.identifier"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :identifier, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors font-mono", placeholder: t("meters.form.identifier_placeholder"), **field_validation(required: false) %>
    <p class="mt-1 text-xs text-gray-400"><%= t("meters.form.identifier_hint") %></p>
  </div>

  <%# Meter type %>
  <div>
    <%= form.label :meter_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :meter_type, Meter.meter_types.keys.map { |k| [t("meters.form.meter_type_#{k}"), k] }, {}, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors" %>
  </div>

  <%# Unit %>
  <div>
    <%= form.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :unit, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", **field_validation %>
  </div>

  <%# Meter group (optional) %>
  <div>
    <%= form.label :meter_group, t("meters.form.meter_group"), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :meter_group, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: t("meters.form.meter_group_placeholder"), **field_validation(required: false) %>
    <p class="mt-1 text-xs text-gray-400"><%= t("meters.form.meter_group_hint") %></p>
  </div>

  <% if local_assigns[:show_initial_reading] %>
    <%# Initial reading %>
    <div>
      <%= label_tag :initial_reading, t("meters.form.initial_reading"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= number_field_tag :initial_reading, nil, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 outline-none transition-colors", placeholder: "0", step: "any", min: "0", **number_validation %>
      <p class="mt-1 text-xs text-gray-400"><%= t("meters.form.initial_reading_hint") %></p>
    </div>
  <% end %>

  <%# Submit %>
  <div>
    <%= form.submit submit_label, class: "w-full bg-brand-600 text-white text-sm font-medium px-4 py-2.5 rounded-lg hover:bg-brand-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
