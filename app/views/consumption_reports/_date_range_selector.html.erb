<section class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="px-4 py-3 space-y-3">
    <div class="flex gap-2 flex-wrap">
      <% pill = ->(label, year_param) {
        active = params[:year].to_s == year_param.to_s || (year_param == Date.today.year && params[:year].blank?)
        cls = active ? "bg-blue-600 text-white" : "bg-gray-100 text-gray-600 hover:bg-gray-200"
        link_to label, consumption_reports_path(year: year_param), class: "px-3 py-1.5 text-xs font-medium rounded-full #{cls}"
      } %>
      <%= pill.call(t("reports.all_time"), "all") %>
      <%= pill.call(Date.today.year.to_s, Date.today.year) %>
      <% @past_years.each do |year| %>
        <%= pill.call(year.to_s, year) %>
      <% end %>
    </div>
    <div class="flex items-center gap-2 text-sm text-gray-500">
      <i class="fa-solid fa-calendar-days text-gray-400 text-xs"></i>
      <span><%= l(@start_date, format: :default) %></span>
      <span>—</span>
      <span><%= l(@end_date, format: :default) %></span>
    </div>
  </div>
</section>
